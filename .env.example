# =============================================================================
# Football Market AI Trader - environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in YOUR OWN values.
#   cp .env.example .env
#
# RULES
#  * NEVER commit the real `.env` file (it is in .gitignore).
#  * NEVER put a seed phrase here. This project never asks for one.
#  * NEVER paste these values into a chat, GitHub issue or Telegram message.
#  * Everything below is OPTIONAL except where marked REQUIRED.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. TRADING MODE  (REQUIRED - safe default)
#    One of: backtest | shadow | paper | live
#    live is additionally gated by POLYMARKET_ALLOW_LIVE_TRADING below.
# -----------------------------------------------------------------------------
TRADING_MODE=backtest
POLYMARKET_ALLOW_LIVE_TRADING=false

# -----------------------------------------------------------------------------
# 2. POLYMARKET  (market data needs NO credentials - public API)
#    Credentials are ONLY needed for live order placement (mode=live).
# -----------------------------------------------------------------------------
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137
# Reveal from https://reveal.polymarket.com  (DEDICATED TRADING WALLET ONLY)
POLYMARKET_PRIVATE_KEY=
# API credentials derived from the key above (L2 auth). Leave blank to derive
# them at runtime with `python -m app.cli init --derive-api-creds`.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
# Address that holds your USDC on Polymarket (the funder/proxy address).
POLYMARKET_FUNDER_ADDRESS=
# 0 = EOA/direct wallet, 1 = Polymarket proxy (email/magic login),
# 2 = browser-wallet proxy (MetaMask / Coinbase Wallet / Rabby).
POLYMARKET_SIGNATURE_TYPE=0

# -----------------------------------------------------------------------------
# 3. FOOTBALL DATA PROVIDERS
#    football-data.co.uk : free historical results + shots/corners/cards + closing odds
#    FPL                 : official Fantasy Premier League API (xG/90, availability, team strength)
#    openfootball        : free fixture/result JSON feeds
# -----------------------------------------------------------------------------
FOOTBALL_DATA_UK_ENABLED=true
FOOTBALL_DATA_UK_BASE_URL=https://www.football-data.co.uk
FOOTBALL_DATA_UK_SEASON=2526
FOOTBALL_DATA_UK_LEAGUES=E0,E1,D1,I1,SP1,F1,N1,P1
FPL_ENABLED=true
OPENFOOTBALL_ENABLED=true

# -----------------------------------------------------------------------------
# 4. OPTIONAL AI LAYER (unstructured news -> structured JSON; never trades)
#    provider: openai | openrouter | anthropic | none
# -----------------------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini
AI_TIMEOUT_SECONDS=45

# -----------------------------------------------------------------------------
# 5. OPTIONAL TELEGRAM NOTIFICATIONS (create your OWN bot with @BotFather)
# -----------------------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_EDGE_TO_NOTIFY=0.08

# -----------------------------------------------------------------------------
# 5b. DASHBOARD / API PASSWORD (optional)
#     Only needed if you put the Streamlit dashboard behind auth or expose it.
#     Leave empty to run the dashboard locally without a password.
# -----------------------------------------------------------------------------
DASHBOARD_PASSWORD=

# -----------------------------------------------------------------------------
# 6. STORAGE
# -----------------------------------------------------------------------------
DATABASE_PATH=data/football_trader.db
DATA_DIR=data
CACHE_DIR=data/cache
LOG_DIR=logs

# -----------------------------------------------------------------------------
# 7. RISK LIMITS  (they can also be edited in configs/config.yaml)
#    Fractional-Kelly sizing; hard caps always win over model sizing.
# -----------------------------------------------------------------------------
RISK_CAPITAL=500
RISK_MAX_TRADE=10
RISK_MAX_DAILY_EXPOSURE=50
RISK_MAX_DAILY_LOSS=20
RISK_MAX_OPEN_POSITIONS=6
RISK_MIN_EDGE=0.08
RISK_MIN_CONFIDENCE=0.75
RISK_MIN_LIQUIDITY=100
RISK_MAX_SPREAD=0.04
RISK_MAX_SLIPPAGE=0.02
RISK_MAX_CORRELATED_EXPOSURE=25
RISK_KELLY_FRACTION=0.25

# -----------------------------------------------------------------------------
# 8. LOGGING / OBSERVABILITY
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false

# -----------------------------------------------------------------------------
# 9. LIVE-MODE CONFIRMATION PHRASE (anti-fat-finger gate)
#    `python -m app.cli live --confirm "I UNDERSTAND THE RISK"` plus
#    POLYMARKET_ALLOW_LIVE_TRADING=true are BOTH required.
# -----------------------------------------------------------------------------
LIVE_CONFIRMATION_PHRASE=I UNDERSTAND THE RISK
